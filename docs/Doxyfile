PROJECT_NAME           = "kaldi-decoder C++ API"
PROJECT_BRIEF          = "Kaldi-compatible decoding C++ API"
OUTPUT_DIRECTORY       = build/doxygen
INPUT                  = ../kaldi-decoder/csrc \
                         mainpage.dox
FILE_PATTERNS          = *.h
RECURSIVE              = NO
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
JAVADOC_AUTOBRIEF      = YES
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3
ALIASES                = "kfile{1}=[\1](https://github.com/kaldi-asr/kaldi/blob/master/\1)" \
                         "kbin{1}=[\1](https://github.com/kaldi-asr/kaldi/blob/master/src/latbin/\1.cc)"
